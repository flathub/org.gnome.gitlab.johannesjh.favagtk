{
  "app-id": "org.gnome.gitlab.johannesjh.favagtk",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "favagtk",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland",
    "--filesystem=host"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "cleanup-commands": [
    "find /app/lib/python3*/site-packages -type d \\( -name tests -o -name test \\) -prune -exec rm -rf {} +"
  ],
  "modules": [
    "requirements/python3-main.json",
    {
      "name": "favagtk",
      "builddir": true,
      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/johannesjh/favagtk.git",
          "tag": "v2.1.0",
          "commit": "80ed4cb31c69a413b766c689bbcc632134748d39"
        }
      ],
      "config-opts": ["-Dprofile=release"]
    }
  ]
}
